{
	quest.14C455D7DCDD094D.quest_desc: ["Klaxium Alloy through a &eMechanical Saw&r."]
	quest.14C455D7DCDD094D.title: "Klaxium Spike"
	quest.26A4B2D8291B03E5.quest_desc: [
		"A plate on the side of any block that holds a &ejet engine&r or a &eSpiked Foot&r. Up to three side by side merge into a single platform."
		""
		"While driving: &fF&r makes every engine fire a burst, for a dash or a dodge; &fR&r makes the Spiked Feet on mounts grab the block in front, like a Sticker."
	]
	quest.26A4B2D8291B03E5.title: "Mount"
	quest.2772D9AFFD78A30E.quest_desc: ["Make a mech climb a wall on Spiked Feet."]
	quest.2772D9AFFD78A30E.title: "Up the Wall"
	quest.35BE3162FB27D960.quest_desc: [
		"&eLeg Hinge&r: bends the next part of the leg along one plane, like a hip or a knee."
		""
		"&eLeg Swivel&r: spins everything past it around the direction it's pointing. Placed facing down under the hull, it's a hip that swings the leg sideways."
		""
		"A joint faces away from the block you place it on: everything you build past it moves with it."
	]
	quest.35BE3162FB27D960.title: "Leg Joints"
	quest.3F823FD905AD03D4.quest_desc: ["Nuggets go into Stabilization Modules, Mounts and the Positioner."]
	quest.4036DEA0C58892A1.quest_desc: [
		"Build a hull around the &eWalker Core&r, hang legs off it with hinges and swivels, and start walking."
		""
		"It moves as long as its &efront face&r gets rotation from a shaft. The faster the shaft spins, the more gears unlock: 16, 32, 64 and 128 RPM for gears 2 to 5."
		""
		"Stress goes up with weight and with what it's doing: high gears, flying and wall-climbing spikes cost more."
		""
		"&eRight-click with an empty hand&r: assembles the mech; after that, it parks it or gets it moving again."
	]
	quest.4036DEA0C58892A1.quest_subtitle: "The heart of the machine"
	quest.4036DEA0C58892A1.title: "Walker Core"
	quest.46369D7E53F51ACA.quest_desc: ["Put the alloy under a &eMechanical Press&r to get a sheet. You'll need lots: almost every component uses at least one."]
	quest.4937636A065F1135.quest_desc: [
		"With Jet Feet on at least half its legs, &fG&r takes the mech off the ground and makes it &efly&r: the faster it goes, the more it tilts. A charged jump fires the jets and goes three times higher."
		""
		"&eFuel&r: lava, piped into the core through any face except the shaft's, or from a &eFluid Tank&r placed against its back."
		""
		"&cJets cut out instantly in water.&r Press G to relight them once you're out."
	]
	quest.4937636A065F1135.title: "Jet Foot"
	quest.4FFD10247BE9EBCE.quest_desc: [
		"Right-click to take the controls:"
		"&fW/S&r forward and back, &fA/D&r turn, &fscroll&r shifts gears, &fSpace&r jumps, &fCtrl&r gallops, &fX/Z&r raise and lower the hull, &fAlt&r plus the mouse tilts it, &fV&r strafes, &fG&r flies or retracts the spikes. &fShift&r to get off."
		""
		"Right-click the core with the controls in hand to &elink&r them: placed anywhere, they drive it remotely."
		"Shift + right-click opens a menu to control &eRedstone Link&r frequencies while you drive."
	]
	quest.4FFD10247BE9EBCE.title: "Pilot Controls"
	quest.5139A05F918E99F9.quest_desc: [
		"&6Klaxium&r is the alloy every single part of a mech is built from."
		""
		"In a &eMechanical Mixer&r over a &eBasin&r: &f1 iron ingot&r, &f2 copper ingots&r, &f2 soul sand&r and &f100 mB of lava&r. No heat needed."
		""
		"Soul sand comes from the Nether: stock up while you're there."
	]
	quest.5139A05F918E99F9.quest_subtitle: "It all starts in the Basin"
	quest.5139A05F918E99F9.title: "Klaxium Alloy"
	quest.5768CD5D09D9E9CE.quest_desc: [
		"Core, hull, at least two legs with joints and feet, Pilot Controls: assemble and walk."
		""
		"Your first mech doesn't have to be pretty. It just has to stay upright."
		""
		"&7Tip: the first time, test it far away from your base."
	]
	quest.5768CD5D09D9E9CE.quest_subtitle: "Build a mech and make it walk"
	quest.5768CD5D09D9E9CE.title: "First Step"
	quest.5991BDAE721BE0BC.quest_desc: ["Make a mech fly on Jet Feet."]
	quest.5991BDAE721BE0BC.title: "Liftoff"
	quest.59A62C1473A99EFD.quest_desc: [
		"Assemble a mech made of &e1000 blocks or more&r."
		""
		"More weight means more stress on the core: you'll need plenty of rotation, and a fast shaft."
		""
		"When you pull it off, bring it to spawn. We want to see it."
	]
	quest.59A62C1473A99EFD.quest_subtitle: "1000 blocks, walking"
	quest.59A62C1473A99EFD.title: "&6Colossus"
	quest.5CCB39CC549319B2.quest_desc: [
		"Sequenced assembly starting from a &ePrecision Mechanism&r, with &fElectron Tubes&r and &fKlaxium Nuggets&r."
		""
		"Keeps the mech balanced: without it, there's no Walker Core."
	]
	quest.5CCB39CC549319B2.title: "Stabilization Module"
	quest.5CD4A630F58E3853.quest_desc: [
		"Drive a mech from the palm of your hand, anywhere in the world."
		""
		"You'll need a Create &eRedstone Link&r to craft it."
	]
	quest.5CD4A630F58E3853.title: "Remote Pilot Controller"
	quest.618242F2BFE27FB0.quest_desc: [
		"Look at a joint to see its angle; &escroll&r to turn it by 5 degrees (1 degree while holding Ctrl)."
		""
		"That's the angle the leg starts from as it walks: this is how you set your mech's stance."
	]
	quest.618242F2BFE27FB0.title: "Positioner"
	quest.6A315ED36E740961.quest_desc: [
		"Caps off a leg: the mech stands and walks on its feet."
		""
		"A chain of joints with no foot is an &oarm&r: it holds its pose and sways as the mech walks."
	]
	quest.6A315ED36E740961.title: "Leg Foot"
	quest.6A36457AA93157DF.quest_desc: [
		"Sequenced assembly: starts from a &fKlaxium Sheet&r and goes through a &fCogwheel&r and &fAndesite Alloy&r."
		""
		"Needed for leg joints. EMI shows the exact steps."
	]
	quest.6A36457AA93157DF.title: "Articulation Unit"
	quest.73FC39A58843E7C0.quest_desc: ["Right-click a &ostripped&r log or wood block with a Klaxium Sheet."]
	quest.7A357BDB4830AE8D.quest_desc: [
		"A foot with four spikes that dig into whatever it's standing on."
		""
		"With Spiked Feet on at least half its legs, the mech &eclimbs walls&r and walks on &eceilings&r as if they were flat ground. &fG&r retracts and extends the spikes."
		""
		"Hanging on by the spikes adds stress to the core, and they let go one second after the rotation stops."
	]
	quest.7A357BDB4830AE8D.title: "Spiked Foot"
	quest.7C564E8261245264.quest_desc: [
		"Sequenced assembly: Iron Sheet, Klaxium Sheet, Fluid Pipe and lava."
		""
		"Jets burn &clava&r: be ready to haul a lot of it."
	]
	quest.7C564E8261245264.title: "Jet Nozzle"
}
