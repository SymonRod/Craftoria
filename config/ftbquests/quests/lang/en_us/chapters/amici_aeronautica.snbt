	quest.0D0600B2080F56D6.title: "Docking"
	quest.1020E2B6B6D7C193.quest_desc: ["Place a propeller and give it rotation to generate thrust."]
	quest.1020E2B6B6D7C193.title: "For Every Action..."
	quest.160363C4C544B76E.quest_desc: ["Iron Sheet and Iron Nuggets. Used for wheel suspension and for the Torsion Spring."]
	quest.160363C4C544B76E.title: "Spring"
	quest.185743ECF5BB7329.quest_desc: ["Sequenced assembly starting from an Industrial Iron Block."]
	quest.185743ECF5BB7329.title: "Engine Assembly"
	quest.1D3A346E895B329C.quest_desc: [
		"Fill an airtight envelope with hot air."
		""
		"Your first airship! The Aviator's Goggles are on the house."
	]
	quest.1D3A346E895B329C.title: "Head in the Clouds"
	quest.2751519880F3D236.quest_desc: [
		"Give it rotation and it pushes: it's what moves planes and airships."
		""
		"There's a wooden one too: switch between the two in a crafting table."
	]
	quest.2751519880F3D236.title: "Propeller"
	quest.314D3DB4E5D37CC8.quest_desc: [
		"Grab the &eSteering Wheel&r and turn it: it passes the rotation on."
		"The &eThrottle Lever&r sets its signal like an Analog Lever, but you hold it in your hand."
		""
		"Together they're enough to drive almost anything."
	]
	quest.314D3DB4E5D37CC8.title: "Steering Wheel and Throttle"
	quest.33F6909507BCD56F.quest_desc: [
		"Set a Navigation Table's destination to a point more than &e5000 blocks&r away."
		""
		"The world border is 5000 blocks from spawn: the destination lies beyond it. But the journey itself? That, you can make."
	]
	quest.33F6909507BCD56F.quest_subtitle: "Destination: beyond the horizon"
	quest.33F6909507BCD56F.title: "&bFar From Home"
	quest.3DE7EB59108EC62B.quest_desc: [
		"Sequenced assembly with Cogwheels, Iron Sheets and Brass Nuggets."
		""
		"Used for the Smart Propeller, the Gyroscopic Propeller Bearing and the Gimbal Sensor."
	]
	quest.3DE7EB59108EC62B.title: "Gyroscopic Mechanism"
	quest.42B9871FD0C8368F.quest_desc: [
		"Let the Levitite Blend crystallize."
		""
		"&eLevitite&r floats: an aircraft built from it flies with no balloons or propellers."
	]
	quest.42B9871FD0C8368F.title: "Unidentified Floating Object"
	quest.4413FF03C20D81A8.quest_desc: ["Dried kelp and a shaft. Also comes in small, large and &omonstrous&r sizes."]
	quest.4413FF03C20D81A8.title: "Tire"
	quest.465B5F72B649DAE8.quest_desc: [
		"Kill a &ePhantom&r with a Mounted Potato Cannon."
		""
		"At night, in flight, after a few sleepless nights."
	]
	quest.465B5F72B649DAE8.title: "Ghostbuster"
	quest.466C6CFCF9FADE11.quest_desc: [
		"A tire goes on it, and it goes under an assembled machine."
		""
		"Portable Engine, Steering Wheel, four mounts with wheels: you've got yourself a car."
	]
	quest.466C6CFCF9FADE11.quest_subtitle: "Four wheels and an engine"
	quest.466C6CFCF9FADE11.title: "Wheel Mount"
	quest.493A6BC46BE46C76.quest_desc: ["Propellers that &eadjust themselves&r: they keep an aircraft level without you correcting it by hand."]
	quest.493A6BC46BE46C76.title: "Gyroscopic Propellers"
	quest.4AC278E435F97D9E.quest_desc: ["The &eBorehead Bearing&r with &eRock Cutting Wheels&r: a mole that digs as it moves forward."]
	quest.4AC278E435F97D9E.title: "Tunnel Borer"
	quest.4C5C5AEB09CD4838.quest_desc: [
		"Engine Assembly plus a Blast Furnace: an engine that burns fuel and makes rotation &ewithout steam&r."
		""
		"Place it and fire it up: it's the right engine for a machine on the move."
	]
	quest.4C5C5AEB09CD4838.title: "Portable Engine"
	quest.4DDDCF19BB5DF580.quest_desc: [
		"The &ePhysics Assembler&r turns a glued structure into a &emachine with real physics&r: it falls, floats, tips over and crashes."
		""
		"It's the foundation of this whole chapter: boats, cars, airships, planes."
		""
		"Glue the blocks together with Create's &eSuper Glue&r, then activate the assembler."
	]
	quest.4DDDCF19BB5DF580.quest_subtitle: "The heart of every physics machine"
	quest.4DDDCF19BB5DF580.title: "Physics Assembler"
	quest.555167933D6060F9.quest_desc: ["In a &eheated&r mixer: End Stone Powder, Zinc Nuggets and water."]
	quest.555167933D6060F9.title: "Levitite Blend"
	quest.610910A9C8628DFA.quest_desc: [
		"The &eHot Air Envelope&r is made from wool and sticks, and can be dyed just like wool."
		"The &eHot Air Burner&r goes underneath and heats the air inside."
		""
		"The envelope must be &esealed airtight&r, or the air escapes."
	]
	quest.610910A9C8628DFA.title: "Hot Air Balloon"
	quest.634F270E169FF316.quest_desc: [
		"Connect a &eRope Connector&r or a &eRope Winch&r with a rope."
		""
		"For towing, hoisting loads under an airship, or mooring."
	]
	quest.634F270E169FF316.title: "Learning the Ropes"
	quest.6B0A7173DE31FAE3.quest_desc: ["Assemble a Propeller Bearing to generate more thrust."]
	quest.6B0A7173DE31FAE3.title: "In Thrust We Trust"
	quest.70EB3B390DF4FF9F.quest_desc: [
		"&eGimbal Sensor&r: tilt. &eAltitude Sensor&r: altitude. &eVelocity Sensor&r: speed."
		""
		"They output a redstone signal: add a bit of logic and you've got an autopilot."
	]
	quest.70EB3B390DF4FF9F.title: "Flight Instruments"
	quest.71DFFF804D163C31.quest_desc: ["Build blades as big as you like on it: far more thrust than a single propeller."]
	quest.71DFFF804D163C31.title: "Propeller Bearing"
	quest.72176E28CFFF764E.quest_desc: [
		"An Iron Sheet filled with honey using a &eSpout&r."
		""
		"Glues a whole group of blocks for assembly in one go, no need to mark them one by one."
	]
	quest.72176E28CFFF764E.title: "Honey Glue"
	quest.756B44FB52C2E784.quest_desc: ["Create's Potato Cannon, in a version you can mount on an aircraft. Made in a &eMechanical Crafter&r."]
	quest.756B44FB52C2E784.title: "Mounted Potato Cannon"
	quest.784BE73BABBD1B1F.quest_desc: ["End Stone through &eCrushing Wheels&r. You'll need to have been to the End."]
	quest.784BE73BABBD1B1F.title: "End Stone Powder"
	quest.78EDA075F5FB67F9.quest_desc: ["Points the way to the coordinates you give it. With a bit of redstone, it steers on its own."]
	quest.78EDA075F5FB67F9.title: "Navigation Table"
