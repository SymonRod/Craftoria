{
	quest.030E566682A89105.quest_desc: [
		"   La &bFuel Canister&r contiene una grande quantità di combustibile."
		""
		"   Si può mettere in qualsiasi slot che accetti normalmente combustibile."
		""
		"   La parte migliore... &osmette di consumare la sua riserva interna&r quando non c'è niente da &6fondere&r, &6affumicare&r, &6bruciare&r o per cui &6generare energia&r."
		""
		"  Così le tue scorte di combustibile durano di più."
		""
		"{image:justdirethings:item/fuel_canister_full width:100 height:100 align:center fit:true}"
	]
	quest.030E566682A89105.quest_subtitle: "Risparmia-combustibile"
