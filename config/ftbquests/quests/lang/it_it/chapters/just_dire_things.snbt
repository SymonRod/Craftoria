	quest.045942C709C63044.quest_subtitle: "Fa quello che c'è scritto sulla scatola"
	quest.08B17C05B2111477.quest_desc: [
		"  Complimenti!"
		""
		"  Hai &6sbloccato&r il &oquarto&r e &oultimo&r livello di &boggetti&r e &bblocchi&r di &lJDT&r."
		""
		"  Gli &bstrumenti&r &6lavorano all'istante&r, l'&barmatura&r ti dà &6poteri&r da &oSuperman&r e la &bbacchetta&r può &6aprire buchi temporanei&r nel mondo. "
		""
		"  Chiunque ti veda con l'equipaggiamento &lJDT&r di livello massimo saprà che hai fatto tutto... l'&2Overworld,&r il &4Nether&r, l'&3End&r e l'&9Abisso oscuro&r."
		""
		"{image:justdirethings:item/eclipsealloy_ingot width:100 height:100 align:center fit:true}"
	]
	quest.08B17C05B2111477.quest_subtitle: "Livello 4: sbloccato"
	quest.0E50E568DFA078D5.quest_desc: [
		"  La progressione di &oJust Dire Things&r ruota attorno a quattro tipi di &o&l&bgoo&r."
		""
		"  Per fabbricare ogni &bgoo&r bisogna visitare regioni diverse."
		""
		"• &b&lPrimogel Goo&r: &6Overworld&r"
		""
		"• &b&lBlazebloom Goo&r: &6Nether&r"
		""
		"• &b&lVoidShimmer Goo&r: &6End&r"
		""
		"• &b&lShadowpulse Goo&r: &6Abisso oscuro&r"
		""
		""
		"{image:justdirethings:block/gooblock_tier4 width:32 height:32 align:center fit:true}"
	]
