	]
	quest.18680FEE2B6FF16F.quest_desc: [
		"  Le colture piantate sulla &bBlazebloom Soil&r si &6raccolgono&r e si &6ripiantano&r da sole."
		""
		"  Ti conviene usare l'&bItem Collector&r di &oJust Dire Things&r per &6raccogliere&r automaticamente il bottino delle colture in un deposito."
		""
		"  La &bBlazebloom Soil&r &6accelera&r anche un po' la crescita delle colture ed è resistente al &6calpestio.&r"
		"  "
		"{image:justdirethings:block/goofarmland_tier2_moist width:100 height:100 align:center fit:true}"
	]
