{
	quest.0012F8780D9172DE.quest_subtitle: "Si trova usando l'Occhio dell'Abisso"
	quest.0012F8780D9172DE.title: "&5Il Leviatano"
	quest.19B550F54950E253.quest_subtitle: "Si trova in rare torri nei biomi freddi. Individua le torri seguendo le Soul Star."
	quest.19B550F54950E253.title: "&bNight Lich"
	quest.1D2EF18DBF02F6EB.quest_desc: [
		"La &6Torre oscura&r si trova in una piccola radura al centro della &2Foresta Oscura&r. "
		""
		"L'area centrale ha foglie rossastre, autunnali, ed erba sbiadita. "
		""
		"La &6Torre oscura&r è il luogo di molti esperimenti ultraterreni."
	]
	quest.1D2EF18DBF02F6EB.quest_subtitle: "Questa creatura ha preso possesso della cima della &6Torre della Foresta Oscura&r e va sconfitta per completare la fase della &2Foresta Oscura&r dell'avventura."
	quest.1D2EF18DBF02F6EB.title: "&8Ur&7-&fGhast"
	quest.2209DC294580BF3D.quest_desc: [
		"Ci sono quattro ingressi naturali. "
		""
		"All'interno puoi trovare un branco di &7Yeti&r, dominati dal massiccio &bAlpha Yeti&r. "
		""
		"Sconfiggi l'&bAlpha Yeti&r in combattimento e prendi un po' della sua pelliccia soffice per rendere accessibile il &3Ghiacciaio&r."
	]
	quest.2209DC294580BF3D.quest_subtitle: "Si trova nella &6Tana degli Yeti&r, tra le colline dalla forma vagamente quadrata."
	quest.2209DC294580BF3D.title: "&bAlpha Yeti"
	quest.320C2F44DD138054.quest_desc: [
		"A differenza degli altri boss, questo animale non va ucciso. "
		""
		"Il giocatore deve invece completare la sua &6Ricerca&r, dandogli della &blana&r di ogni colore."
		""
		"Puoi dargli la &blana&r lasciandola cadere sotto l'&cAriete&r oppure usando la &blana&r su di lui. "
		""
		"Ogni volta che gli dai un blocco di &blana&r, il suo corpo si allunga e gli viene aggiunta una striscia di lana di quel colore. "
		""
		"Quando la sua ricerca è completa, rilascia un &6Trofeo&r che completa questa quest."
	]
	quest.320C2F44DD138054.quest_subtitle: "Un boss amichevole, un animale che si trova nel &6Boschetto della ricerca&r, presente solo nel bioma della &dForesta Incantata&r."
	quest.320C2F44DD138054.title: "&3Ariete della ricerca"
	quest.413557ECF489FD2C.quest_subtitle: "Compare in rare strutture sulle isole dell'End."
	quest.413557ECF489FD2C.title: "&5Obsidilith"
	quest.4A559B47D164D1BB.quest_subtitle: "Si trova usando l'Occhio della Maledizione"
	quest.4A559B47D164D1BB.title: "&bMale&edictus"
	quest.4C357D8CF72B8F25.quest_subtitle: "Compare in rare strutture del Nether. "
	quest.4C357D8CF72B8F25.title: "&4Nether Gauntlet"
	quest.4CA99DC1D953E1FB.quest_subtitle: "Si trova usando l'Occhio del Vuoto"
	quest.4CA99DC1D953E1FB.title: "&dGuardiano di Ender"
	quest.5570CFF754032FDB.quest_desc: [
		"Nella torre vive una varietà di creature di ghiaccio, mentre la &9Regina delle nevi&r ti aspetta in una stanza coperta di brina vicino alla cima. "
		""
		"È protetta da uno scudo di &bghiaccio&r e attacca con una raffica di colpi gelidi oppure carica addosso all'avventuriero. "
		""
		"Sconfiggere in combattimento la &9Regina delle nevi&r completerà la fase della &bForesta Innevata&r dell'avventura."
	]
	quest.5570CFF754032FDB.quest_subtitle: "Si trova in una torre colorata nei &3Ghiacciai&r."
	quest.5570CFF754032FDB.title: "&9Regina delle nevi"
	quest.56723AEFD93C17F1.quest_subtitle: "Si trova usando l'Occhio del Deserto"
	quest.56723AEFD93C17F1.title: "&6Antico Rimasuglio"
	quest.5DBFD3F917C4E49C.quest_subtitle: "Si trova usando l'Occhio di Mech"
	quest.5DBFD3F917C4E49C.title: "&4L'Araldo"
	quest.630EF1A8715E2D90.quest_subtitle: "Si trova usando l'Eye of Storm"
	quest.630EF1A8715E2D90.title: "&eScylla"
	quest.63EC4C04DD5C0CA6.quest_subtitle: "Si trova usando l'Occhio della Fiamma"
	quest.63EC4C04DD5C0CA6.title: "&6Ignis"
	quest.63F26CC561D0B80D.quest_desc: [
		"La &6Torre&r è protetta da un incantesimo che impedisce di rompere i blocchi e di ferire i nemici. "
		""
		"L'unico modo per entrare è sconfiggere la &aNaga&r."
		""
		"Uccidi il &eLich&r e ottieni uno dei suoi scettri magici per aprire tre aree da esplorare:"
		""
		"* &aLa Palude"
		"* &bLa Foresta Innevata"
		"* &2La Foresta Oscura"
	]
	quest.63F26CC561D0B80D.quest_subtitle: "Si trova all'interno della sua &6Torre del Lich&r, un grande complesso con più torri ramificate nella foresta. "
	quest.63F26CC561D0B80D.title: "&eLich"
	quest.6531DF5573672E9E.quest_desc: [
		"Non c'è nessun labirinto o dungeon da attraversare, perché l'&1Idra&r non ha bisogno di proteggersi dagli intrusi."
		""
		"Buona fortuna! "
		""
		"Se sopravvivi, tocca il &6Sangue ardente dell'Idra&r e la fase della &aPalude&r dell'avventura sarà completata."
	]
	quest.6531DF5573672E9E.quest_subtitle: "Si trova in una Collina cava trasformata, in mezzo alla &6Palude Infuocata&r."
	quest.6531DF5573672E9E.title: "&1Idra"
	quest.67785FD77E880DDB.quest_subtitle: "Compare in rare caverne sul fondo del mondo. I Void Lily ti indicheranno la strada."
	quest.67785FD77E880DDB.title: "&dVoid Blossom"
	quest.692049F6F50CC017.quest_desc: [
		"Sotto la &2Foresta Oscura&r (e a volte nelle zone circostanti) giacciono le roccaforti in rovina dei &6Cavalieri del Crepuscolo&r. "
		""
		"I livelli inferiori delle roccaforti sono completamente sigillati e, prima di entrare, dovrai completare una piccola &bcerimonia di iniziazione&r. "
		""
		"Dovrai trovare una stanza specifica nelle rovine superiori della roccaforte. "
		""
		"La stanza contiene un &bPiedistallo dei trofei&r e una fossa poco profonda bloccata da &6Scudi della roccaforte&r."
		""
		"Se metti sul piedistallo un trofeo di uno dei boss precedenti, lo scudo sparirà e potrai accedere ai livelli inferiori."
		""
		"Una volta dentro la parte principale della roccaforte, dovrai trovare i &aCavalieri Fantasma&r per proseguire. "
		""
		"Mandare i fantasmi al loro riposo finale farà sì che gli strani dispositivi della &8Torre oscura&r ti obbediscano."
	]
	quest.692049F6F50CC017.quest_subtitle: "Si trova nelle profondità delle roccaforti."
	quest.692049F6F50CC017.title: "&2Cavaliere Fantasma"
	quest.72FF205D1C9A9178.quest_subtitle: "Si trova usando l'Occhio del Mostruoso"
	quest.72FF205D1C9A9178.title: "&cMostro di Netherite"
	quest.7DA49A7F33A82D1C.quest_desc: [
		"Nel &6Cortile&r ci sono pochissimi ostacoli, e la &aNaga&r può abbatterli con la stessa facilità."
		""
		"Uccidi la &aNaga&r e tocca una delle sue squame magiche per poter entrare nell'area successiva."
	]
	quest.7DA49A7F33A82D1C.quest_subtitle: "Si trova in un cortile ornato con motivi a serpente."
	quest.7DA49A7F33A82D1C.title: "&aNaga"
	quest.7DB4E20D476B5786.quest_desc: ["Uccidi il &cFungotauro&r e mangia un po' della sua &bMistecca Stroganoff&r per poter entrare nella &6Palude Infuocata&r senza bruciarti."]
	quest.7DB4E20D476B5786.quest_subtitle: "Puoi trovare un ingresso naturale attraverso una spaccatura o una caverna, oppure in un piccolo tumulo."
	quest.7DB4E20D476B5786.title: "&cFungotauro"
}
