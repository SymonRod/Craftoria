	quest.2A5CD188C06D7F3C.quest_subtitle: "Come sapere se è nel raggio"
	quest.2A5CD188C06D7F3C.title: "Come sapere se è nel raggio?"
	quest.2BBC228E24D5EF05.quest_desc: [
		"Il &bPortale di curvatura&r è un'altra soluzione per andare da A a B. "
		"Una volta costruito, resta lì e lo puoi usare per sempre."
		""
		"&l1. Informazioni&r"
		"- &bPergamena deformante&r"
		"&8Portale permanente nella stessa dimensione"
		""
		"- &bPergamena Warp stabilizzata&r"
		"&8Portale permanente tra dimensioni"
		""
		"- &lIl portale è a senso unico&r"
		"&8non creerà un altro portale nella posizione che hai impostato nella pergamena"
		""
		"- &9Dimensioni&r e &6orientamento&r"
		"&8+ Materiale della cornice: &bSourcestone &8(o varianti)"
		""
		"&8+ Almeno &91x1 &8di area dentro la &bcornice &8(i blocchi degli angoli possono essere qualsiasi)"
		"&8(la cornice minima sarà &93x3 &8(vuota al centro))"
		""
		"&8+ Può essere &6orizzontale &8(portale dell'End) o &6verticale &8(portale del Nether)"
		""
		"&l2. Come si crea?&r"
		"- Costruisci una &bcornice&r. (guarda il portale dell'End e quello del Nether)"
		"- Tieni un Fonte Vaso &9PIENO&r nelle vicinanze."
		"- Lancia dentro la &bPergamena deformante&r / &bPergamena Warp stabilizzata&r."
		""
		"&l3. Come si rompe?&r"
		"- &6Rompi&r un blocco della cornice."
		""
		""
		"&4NOTA&r: una volta creato, non ha più bisogno di &5fonte&r per funzionare."
		"&4NOTA 2&r: ripeto, i blocchi agli angoli della cornice non servono."
	]
	quest.2BBC228E24D5EF05.quest_subtitle: "Più basi?"
	quest.2BBC228E24D5EF05.title: "Portale di curvatura"
