	quest.3447A04FA017C790.quest_desc: [
		"!!! GLI OGGETTI SUI &bPIEDISTALLI&r NON VENGONO CONSUMATI !!!"
		""
		"&8Oggetto principale (al centro nella ricetta EMI)"
		"&8Oggetti aggiuntivi (intorno all'oggetto principale)"
		"&l1. Come si usa?&r "
		"Metti gli &boggetti aggiuntivi&r sui &bpiedistalli&r &8(se la ricetta li richiede)&r -> metti l'&boggetto principale&r nella &bCamera di impregnazione&r"
		"-> aspetta che finisca la lavorazione -> prendi il risultato dalla &bCamera di impregnazione&r."
		""
		"&l2. Disposizione&r"
		"&8P = Piedistallo  |  I = Camera di impregnazione "
		"P P P"
		"P I P"
		"P P P"
		"&8(consiglio: i piedistalli possono stare 1 blocco sopra o sotto)&r"
		""
		""
		"&4NOTA 1&r: non richiede &5fonte&r per funzionare (si può velocizzare con la &5fonte&r)."
		"&4NOTA 2&r: ingresso e uscita si possono automatizzare con le &btubature&r."
		""
		"!!! GLI OGGETTI SUI &bPIEDISTALLI&r NON VENGONO CONSUMATI !!!"
	]
