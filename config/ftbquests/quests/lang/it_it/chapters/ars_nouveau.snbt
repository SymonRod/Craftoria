	]
	quest.511C07DFE796F377.title: "Glifi di livello 1"
	quest.5253D3AA5B45369E.quest_desc: [
		"Qui parliamo del &bglifo di forma Proiettile&r."
		""
		"È speciale perché applica gli &5effetti dell'incantesimo&r a ogni proiettile."
		"&4NOTA&r: gli &bstrumenti dell'incantatore&r potrebbero non seguire questa regola ... &0(che vuoi farci, è una mod di magia)&r"
		""
		"&8Proiettile -> Forare -> Forare -> Forare -> Rottura -> Forare&r"
		"- &bGlifo di aumento Forare&r: fa colpire al proiettile 1 blocco in più per ogni glifo."
		"- &bGlifo Proiettile&r con 3 &bglifi di aumento Forare&r: perfora 3 &bblocchi&r in più"
		"- Gli &5effetti dell'incantesimo&r in questo caso saranno: &8Rottura -> Forare&r"
		"=> Un proiettile che colpisce 4 volte, applicando ogni volta gli &5effetti dell'incantesimo&r qui sopra"
		""
		""
		"Quanti &bblocchi&r pensi che romperà? (guarda la &bPagina 2&r per la risposta)"
		""
		"{@pagebreak}"
		"5 blocchi? &4Sbagliato&r"
		""
		"8 blocchi? &2Esatto&r"
		"&8Un proiettile che colpisce 4 volte, applicando ogni volta gli &5effetti dell'incantesimo&r qui sopra"
		"&8<=> Un proiettile che colpisce 4 volte, rompendo ogni volta 1 blocco e quello dietro di esso&r"
		""
		""
		"&4NOTA&r: gli &bstrumenti dell'incantatore&r non seguono questa regola &8:(&r"
	]
	quest.5253D3AA5B45369E.quest_subtitle: "Il glifo Proiettile"
